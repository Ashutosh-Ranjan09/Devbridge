# Copy to .env. The defaults work with the same local Claude Code wrapper cvv uses.

# Which model writes stories, chooses parameters and extracts JD skills:
# "claude-code" (the local wrapper) or "ollama". Unset or unreachable: every model
# step falls back to code — template stories, seeded parameters, rule-based JD skills.
ASSESS_LLM_BACKEND=claude-code
ASSESS_CLAUDE_CODE_URL=http://127.0.0.1:8000
# ASSESS_CLAUDE_CODE_API_KEY=          the wrapper's key
ASSESS_CLAUDE_CODE_MODEL=sonnet

ASSESS_OLLAMA_URL=http://localhost:11434
ASSESS_OLLAMA_MODEL=qwen3:1.7b

# The sandbox image candidate code runs in. Build it with: assess sandbox build
ASSESS_SANDBOX_IMAGE=assess-python:3.12
