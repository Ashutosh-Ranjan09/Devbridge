# Copy to .env. scripts/dev.sh writes one with a fresh encryption key the first time.

# The key every message is sealed with (AES-256-GCM): 32 bytes, base64.
# `uv run chat keygen` prints one. Lose it and the stored messages cannot be read;
# change it and the old ones cannot either. Never commit it.
CHAT_ENCRYPTION_KEY=

# Bearer key the web sends. Unset: one is generated and printed at startup.
CHAT_API_KEY=
