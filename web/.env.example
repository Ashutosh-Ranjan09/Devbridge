# Copy to .env (gitignored). Next.js, Prisma and scripts/create-admin.ts all read it.

# The web layer's own database: users, organisations, and links to module ids.
DATABASE_URL="file:./.data/web.db"

# The four modules. Keys are the ones each prints at startup, or sets in its own .env.
M5_URL="http://127.0.0.1:8080"
M5_API_KEY=""
M6_URL="http://127.0.0.1:8300"
ASSESS_URL="http://127.0.0.1:8070"
ASSESS_API_KEY=""
CHAT_URL="http://127.0.0.1:8090"
CHAT_API_KEY=""
