// The web layer's own data: who people are, and which module ids are theirs.
//
// Never a copy of a report, a score, a job's skills or a result — each is fetched from
// the module that owns it (M5, M6, assessment), so there is one source of truth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum OrgKind {
  ENTERPRISE
  CLIENT
}

enum ApplicationStatus {
  APPLIED
  ASSESSMENT_SENT
  SUBMITTED
  DECIDED
}

enum Outcome {
  ADVANCE
  REJECT
  HIRE
}

enum Mark {
  VERIFIED
  UNVERIFIED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())
  sessions     Session[]
  candidate    Candidate?
  memberships  Membership[]
  jobsCreated  Job[]
  decisions    Decision[]
  reviews      ItemReview[]
  resets       PasswordReset[] @relation("resets")
  resetsMade   PasswordReset[] @relation("resetsMade")
}

/// A login. The cookie holds a random token; only its SHA-256 is stored, so a copy
/// of this database cannot be used to sign in as anyone.
model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organisation {
  id      String       @id @default(cuid())
  name    String
  kind    OrgKind
  members Membership[]
  jobs    Job[]
}

model Membership {
  userId String
  orgId  String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
}

model Candidate {
  userId           String         @id
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pseudonymous: the only identity M5, M6 and assessment ever see. Never a name or
  /// email (the contract's rule), so only this table knows who a subject is.
  subjectRef       String         @unique
  /// Handles the candidate typed on upload, kept to fill the form next time. Sent to
  /// M5 with each CV, which uses one only where the CV names none for that platform.
  githubHandle     String?
  codeforcesHandle String?
  leetcodeHandle   String?
  codechefHandle   String?
  verifications    Verification[]
  applications     Application[]
  assessments      Assessment[]
}

model Verification {
  /// M5's verification_id.
  id          String    @id
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [userId])
  fileName    String
  /// What the candidate typed beside the CV: their own words, shown to the people who
  /// read the report and labelled as unchecked. Never sent to a module or a model.
  note        String?
  createdAt   DateTime  @default(now())
  /// Set once M6 has accepted the report.
  sentToM6At  DateTime?
  reviews     ItemReview[]
  proofs      Proof[]

  @@index([candidateId])
}

/// A document the candidate uploaded to back a line of their CV that no source can
/// check (an internship, a job, a certificate). Theirs, kept here like their note: never
/// sent to a module, and nothing in it is checked by the system. The file lives on disk
/// under .data/files/proofs/, named by this id.
model Proof {
  id             String       @id @default(cuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id])
  /// M5's claim_id the document supports; null for one the candidate added on their own.
  claimId        String?
  /// What it supports, in the CV's words when it is for a claim, kept so the label
  /// survives M5 forgetting the report.
  label          String
  fileName       String
  createdAt      DateTime     @default(now())

  @@index([verificationId])
}

model Job {
  /// assessment's job_id; the skills and their status live there.
  id           String        @id
  title        String
  orgId        String
  org          Organisation  @relation(fields: [orgId], references: [id])
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  /// Listed for candidates; only a confirmed job is opened.
  open         Boolean       @default(false)
  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([orgId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id])
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [userId])
  status      ApplicationStatus @default(APPLIED)
  createdAt   DateTime          @default(now())
  assessments Assessment[]
  decision    Decision?

  @@unique([jobId, candidateId])
}

model Assessment {
  /// assessment's session_id.
  id            String       @id
  candidateId   String
  candidate     Candidate    @relation(fields: [candidateId], references: [userId])
  /// Null: practice, not for a job.
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  createdAt     DateTime     @default(now())
  sentToM6At    DateTime?

  @@index([candidateId])
}

/// A person decided: who, what, why and when. Never the system.
model Decision {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  decidedById   String
  decidedBy     User        @relation(fields: [decidedById], references: [id])
  outcome       Outcome
  reason        String
  createdAt     DateTime    @default(now())
}

/// An admin checked one line of an M5 report by hand. The report is not changed: this
/// is a person's verdict beside it, shown as theirs. Never updated; marking again adds
/// a row, and the newest row per line is the current mark.
model ItemReview {
  /// Newest is the highest id, even within one millisecond.
  id             Int          @id @default(autoincrement())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id])
  /// "verified:3" (the line's place in its bucket) or "contradicted:f01" (the finding's
  /// id). A report is immutable under its verification_id, so a place never moves.
  itemKey        String
  mark           Mark
  note           String
  reviewedById   String
  reviewedBy     User         @relation(fields: [reviewedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([verificationId, itemKey])
}

/// A failed login, by the email typed (whether or not it has an account, so the limit
/// says nothing about which emails do). Cleared by a successful login.
model LoginFailure {
  id    Int      @id @default(autoincrement())
  email String
  at    DateTime @default(now())

  @@index([email, at])
}

/// A one-time password reset an admin made. Only the token's SHA-256 is stored, like a
/// session's: the link is shown once, to the admin, who gives it to the person.
model PasswordReset {
  tokenHash   String    @id
  userId      String
  user        User      @relation("resets", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("resetsMade", fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}
