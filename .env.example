# Copy to .env. Every value here is optional — the defaults in src/cvv/config.py work
# on a machine with Ollama running locally.

CVV_OLLAMA_URL=http://localhost:11434
CVV_OLLAMA_MODEL=qwen3:1.7b

# num_ctx defaults to 4096 in Ollama and truncates SILENTLY. Always explicit.
CVV_NUM_CTX=8192
CVV_SEED=7

# How many model layers to place on the GPU. Leave unset and Ollama picks from
# whatever VRAM is free, which is the one measured source of non-determinism: the
# same document and seed gave 18 items in one session and 22 in another, because the
# layer split moved with what else was using the card.
#
# Pin it for reproducible runs. qwen3:1.7b has 28 blocks; on a 4 GB card ~25 fits.
# Check the current split with: ollama ps
# CVV_NUM_GPU=25

# A personal access token is enough — GitHub App auth is not needed.
# CVV_GITHUB_TOKEN=
