# Copy to .env. Every value here is optional — the defaults in src/cvv/config.py work
# on a machine with Ollama running locally.

CVV_OLLAMA_URL=http://localhost:11434
CVV_OLLAMA_MODEL=qwen3:1.7b

# num_ctx defaults to 4096 in Ollama and truncates SILENTLY. Always explicit.
CVV_NUM_CTX=8192
CVV_SEED=7

# How many model layers to place on the GPU. Leave unset and Ollama picks from
# whatever VRAM is free, which is the one measured source of non-determinism: the
# same document and seed gave 18 items in one session and 22 in another, because the
# layer split moved with what else was using the card.
#
# Pin it for reproducible runs. qwen3:1.7b has 28 blocks; on a 4 GB card ~25 fits.
# Check the current split with: ollama ps
# CVV_NUM_GPU=25

# A personal access token is enough — GitHub App auth is not needed.
# CVV_GITHUB_TOKEN=

# Where verifications are stored. Unset keeps them IN MEMORY: a restart loses every
# one, and a second process shares none. `cvv serve` warns when that is the case.
#
#   postgresql:///cvv                      a local server, peer auth over the socket
#   postgresql://u:p@host:5432/cvv         anywhere else
#
# A DSN that is set and unreachable fails loudly rather than falling back to memory —
# see the note in CLAUDE.md about why this stays local.
# CVV_DATABASE_URL=postgresql:///cvv

# The HTTP surface's bearer token. Unset generates one per run and prints it, which
# means every restart invalidates whatever a client was using. Set it to keep one.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# CVV_API_KEY=

# error | warning | info | debug. Logs go to STDERR, so `cvv verify --json` stays a
# file that parses, and they never carry CV content — see logs.py.
# CVV_LOG_LEVEL=info

# Seconds before a model call is abandoned. Generous by default: a cold Ollama load
# on a small card can take minutes before the first token.
# CVV_REQUEST_TIMEOUT=600
